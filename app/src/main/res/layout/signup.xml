<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6FA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create Account" android:textSize="30sp" android:textStyle="bold" android:textColor="#202B45" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign up to get started" android:textSize="15sp" android:textColor="#777777" android:layout_marginBottom="30dp"/>
        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Full Name" android:padding="14dp" android:backgroundTint="#5269A5" android:inputType="textPersonName" android:layout_marginBottom="14dp" android:background="@drawable/edittext_background" android:textColor="#202124" android:textColorHint="#9CA3AF" />
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="55dp" android:hint="Student ID" android:padding="14dp" android:backgroundTint="#5269A5" android:inputType="text" android:layout_marginBottom="14dp" android:background="@drawable/edittext_background"
            android:textColor="#202124"
            android:textColorHint="#9CA3AF"/>
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="55dp" android:hint="4-digit PIN" android:padding="14dp" android:backgroundTint="#5269A5" android:inputType="numberPassword" android:layout_marginBottom="14dp" android:background="@drawable/edittext_background"
            android:textColor="#202124"
            android:textColorHint="#9CA3AF"/>
        <Button android:id="@+id/btnSignUp" android:layout_width="match_parent" android:layout_height="55dp" android:text="SIGN UP" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#405A9B"/>
        <TextView android:id="@+id/tvLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have an account? Log In" android:textSize="14sp" android:textColor="#405A9B" android:layout_marginTop="25dp"/>
    </LinearLayout>
</ScrollView>